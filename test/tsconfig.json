{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "verbatimModuleSyntax": false,
    "rootDir": "..",
    "outDir": "../.test-dist",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@opencode-ai/plugin": [
        "../node_modules/@opencode-ai/plugin/dist/index.d.ts"
      ],
      "@opencode-ai/sdk": ["../node_modules/@opencode-ai/sdk/dist/index.d.ts"],
      "@opencode-ai/sdk/v2": [
        "../node_modules/@opencode-ai/sdk/dist/v2/index.d.ts"
      ]
    }
  },
  "include": ["../src/**/*.ts", "./*.ts"]
}
